    "message": "This is a sample message.",
    "maskedNumber": "XYZ",
    "telco": "Safaricom",
    "senderId": "ABC",
    "phoneNumbers": []
}'
Example Response
{
    "SMSMessageData": {
        "Message": "Sent to 1/1 Total Cost: KES 0.8000",
        "Recipients": [{
            "statusCode": 101,
            "number": "+254711XXXYYY",
            "status": "Success",
            "cost": "KES 0.8000",
