Curl
Copy
curl -X POST \
    https://api.africastalking.com/version1/messaging/bulk \
    -H 'Accept: application/json' \
    -H 'Content-Type: application/json' \
    -H 'apiKey: MyAppApiKey' \
    -d '{
    "username": "username",
    "message": "This is a sample message.",
    "senderId": "ABC",
    "phoneNumbers": [
        "+254711XXXYYY",
        "+254711YYYZZZ"
    ]
}'

curl -X POST \
    https://api.africastalking.com/version1/messaging/bulk \
    -H 'Accept: application/json' \
    -H 'Content-Type: application/json' \
    -H 'apiKey: MyAppApiKey' \
    -d '{
