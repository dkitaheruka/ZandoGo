// ============================================================================
// Plateforme E-commerce Multi-Acteurs — Schéma Prisma
// PostgreSQL 16 — voir architecture-ecommerce-rdc.md pour la logique métier
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  ADMIN
  VENDOR_OWNER
  VENDOR_STAFF
  DELIVERY_AGENT
  CUSTOMER
  ADVERTISER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum Currency {
  USD
  CDF
}

enum KycType {
  ID_CARD
  VENDOR_LICENSE
  DRIVER_LICENSE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum FulfillmentMode {
  SELF_SHIP
  PLATFORM_WAREHOUSE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum SubOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethodCode {
  MOBILE_MONEY_ORANGE
  MOBILE_MONEY_AIRTEL
  MOBILE_MONEY_MPESA
  CARD_STRIPE
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WalletOwnerType {
  VENDOR
  DELIVERY_AGENT
  PLATFORM
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxStatus {
  LOCKED
  AVAILABLE
  HELD_FOR_DISPUTE
}

enum WalletTxReference {
  ORDER_PAYOUT
  COMMISSION
  DELIVERY_FEE
  AD_PURCHASE
  WITHDRAWAL
  REFUND
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum DeliveryAffiliation {
  PLATFORM_POOL
  VENDOR_DEDICATED
}

enum DeliveryAgentStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum DeliveryStatus {
  AWAITING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum DeliveryProofType {
  SIGNATURE
  PHOTO
  OTP_CODE
}

enum DisputeReason {
  PRODUCT_NOT_RECEIVED
  PRODUCT_DAMAGED
  WRONG_ITEM
  OTHER
}

enum DisputeStatus {
  OPEN
  AWAITING_VENDOR_RESPONSE
  UNDER_ADMIN_REVIEW
  RESOLVED_REFUND
  RESOLVED_RELEASE
  RESOLVED_PARTIAL
}

enum AdType {
  FEATURED_HOMEPAGE
  CATEGORY_BOOST
  SEARCH_PRIORITY
}

enum AdCostModel {
  CPC
  CPM
  FLAT_FEE
}

enum AdCampaignStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum ConversationType {
  CUSTOMER_VENDOR
  CUSTOMER_DELIVERY
  SUPPORT
}

// ----------------------------------------------------------------------------
// IDENTITÉ & UTILISATEURS
// ----------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  email              String?    @unique
  phone              String?    @unique
  passwordHash       String
  fullName           String
  status             UserStatus @default(PENDING_VERIFICATION)
  preferredCurrency  Currency   @default(USD)
  preferredLanguage  String     @default("fr")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  roles              UserRole[]
  addresses          Address[]
  kycDocuments       KycDocument[]
  vendorStores       VendorStore[]        @relation("StoreOwner")
  orders             Order[]
  cart               Cart?
  deliveryAgent      DeliveryAgent?
  sentMessages       Message[]            @relation("MessageSender")
  notifications      Notification[]
  auditLogsActed     AuditLog[]           @relation("AuditActor")
  disputesRaised     Dispute[]            @relation("DisputeRaisedBy")
  disputesResolved   Dispute[]            @relation("DisputeResolvedBy")
  adCampaigns        AdCampaign[]
  exchangeRatesSet   ExchangeRate[]
  reviews            Review[]

  @@map("users")
}

model UserRole {
  id       String   @id @default(uuid())
  userId   String
  role     RoleName
  scopeId  String? // ex: storeId pour un VENDOR_STAFF
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_roles")
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  label          String?
  commune        String?
  quartier       String?
  ville          String?
  referencePoint String? // repère textuel, indispensable en RDC
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model KycDocument {
  id           String    @id @default(uuid())
  userId       String
  type         KycType
  // Clé dans le bucket PRIVÉ (ex: kyc/<userId>/<uuid>.pdf), jamais une URL : le fichier n'est
  // lisible que via une URL signée de courte durée, délivrée à un admin et journalisée.
  fileKey      String
  status       KycStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

// ----------------------------------------------------------------------------
// VENDEURS & CATALOGUE
// ----------------------------------------------------------------------------

model VendorStore {
  id                 String          @id @default(uuid())
  ownerId            String
  storeName          String
  slug               String          @unique
  description        String?
  logoUrl            String?
  bannerUrl          String?
  status             StoreStatus     @default(PENDING)
  commissionRate     Decimal?        @db.Decimal(5, 2) // override négocié ; NULL = règle par catégorie
  fulfillmentMode    FulfillmentMode @default(SELF_SHIP)
  payoutBlocked      Boolean         @default(false)
  payoutBlockReason  String?
  isCertified        Boolean         @default(false)
  certifiedUntil     DateTime?
  hasMonthlyAd       Boolean         @default(false)
  monthlyAdPlan      String?
  monthlyAdUntil     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  owner       User          @relation("StoreOwner", fields: [ownerId], references: [id])
  products    Product[]
  subOrders   OrderSubOrder[]
  deliveryAgents DeliveryAgent[]

  @@map("vendor_stores")
}

model Category {
  id       String     @id @default(uuid())
  parentId String?
  name     String
  slug     String     @unique
  icon     String?

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]        @relation("CategoryTree")
  products        Product[]
  commissionRules CommissionRule[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  storeId       String
  categoryId    String
  title         String
  slug          String        @unique
  description   String?
  basePriceUsd  Decimal       @db.Decimal(12, 2)
  basePriceCdf  Decimal       @db.Decimal(16, 2)
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  boostedUntil  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store    VendorStore       @relation(fields: [storeId], references: [id])
  category Category          @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
  adCampaigns AdCampaign[]

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  sku        String  @unique
  attributes Json? // ex: {"couleur":"rouge","taille":"XL"}
  priceOverride Decimal? @db.Decimal(12, 2)
  stockQty   Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id       String  @id @default(uuid())
  productId String
  url      String
  position Int     @default(0)
  altText  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  customerId   String
  orderItemId  String   @unique
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  customer  User      @relation(fields: [customerId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("reviews")
}

// ----------------------------------------------------------------------------
// PANIER & COMMANDES
// ----------------------------------------------------------------------------

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique
  currency   Currency @default(USD)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User       @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id                 String  @id @default(uuid())
  cartId             String
  productVariantId   String
  quantity           Int
  unitPriceSnapshot  Decimal @db.Decimal(12, 2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("cart_items")
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  customerId         String
  status             OrderStatus @default(PENDING_PAYMENT)
  currency           Currency
  subtotal           Decimal     @db.Decimal(14, 2)
  shippingFee        Decimal     @db.Decimal(12, 2) @default(0)
  platformFee        Decimal     @db.Decimal(12, 2) @default(0)
  total              Decimal     @db.Decimal(14, 2)
  deliveryAddressId  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customer         User                @relation(fields: [customerId], references: [id])
  deliveryAddress  Address?            @relation(fields: [deliveryAddressId], references: [id])
  subOrders        OrderSubOrder[]
  statusHistory    OrderStatusHistory[]
  paymentTransactions PaymentTransaction[]
  disputes         Dispute[]

  @@map("orders")
}

model OrderSubOrder {
  id                String         @id @default(uuid())
  orderId           String
  storeId           String
  status            SubOrderStatus @default(PENDING)
  subtotal          Decimal        @db.Decimal(14, 2)
  commissionAmount  Decimal        @db.Decimal(12, 2)
  commissionRateApplied Decimal    @db.Decimal(5, 2) // figé au moment de la commande
  createdAt         DateTime       @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store      VendorStore @relation(fields: [storeId], references: [id])
  items      OrderItem[]
  delivery   Delivery?

  @@map("order_sub_orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  subOrderId       String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  totalPrice       Decimal @db.Decimal(14, 2)

  subOrder OrderSubOrder  @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id])
  review   Review?
  disputes Dispute[]

  @@map("order_items")
}

// Traçabilité : chaque changement de statut est journalisé, jamais écrasé
model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedByUserId String?
  note          String?
  createdAt     DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ----------------------------------------------------------------------------
// PAIEMENTS & FINANCE (append-only pour la traçabilité)
// ----------------------------------------------------------------------------

model PaymentTransaction {
  id                    String            @id @default(uuid())
  orderId               String
  methodCode            PaymentMethodCode
  providerReference     String?
  amount                Decimal           @db.Decimal(14, 2)
  currency              Currency
  exchangeRateApplied   Decimal?          @db.Decimal(12, 4)
  status                PaymentStatus     @default(INITIATED)
  rawProviderPayload    Json?
  createdAt             DateTime          @default(now())
  confirmedAt           DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@map("payment_transactions")
}

model Wallet {
  id        String          @id @default(uuid())
  ownerType WalletOwnerType
  ownerId   String
  currency  Currency
  balance   Decimal         @db.Decimal(14, 2) @default(0)

  transactions WalletTransaction[]
  payoutRequests PayoutRequest[]

  @@unique([ownerType, ownerId, currency])
  @@map("wallets")
}

// Grand livre append-only : jamais d'UPDATE/DELETE, seulement des insertions.
model WalletTransaction {
  id            String            @id @default(uuid())
  walletId      String
  type          WalletTxType
  amount        Decimal           @db.Decimal(14, 2)
  currency      Currency
  referenceType WalletTxReference
  referenceId   String?
  status        WalletTxStatus    @default(LOCKED)
  availableAt   DateTime? // delivered_at + 48h, calculé à la création
  balanceAfter  Decimal           @db.Decimal(14, 2)
  createdAt     DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("wallet_transactions")
}

model PayoutRequest {
  id           String       @id @default(uuid())
  walletId     String
  amount       Decimal      @db.Decimal(14, 2)
  method       String
  status       PayoutStatus @default(REQUESTED)
  processedBy  String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("payout_requests")
}

// Taux de commission par catégorie — append-only (nouvelle ligne à chaque changement)
model CommissionRule {
  id              String    @id @default(uuid())
  categoryId      String
  commissionRate  Decimal   @db.Decimal(5, 2)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdByAdminId String

  category Category @relation(fields: [categoryId], references: [id])

  @@map("commission_rules")
}

// Taux de change — append-only, saisie manuelle admin
model ExchangeRate {
  id            String   @id @default(uuid())
  fromCurrency  Currency
  toCurrency    Currency
  rate          Decimal  @db.Decimal(12, 4)
  setByAdminId  String
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  setByAdmin User @relation(fields: [setByAdminId], references: [id])

  @@map("exchange_rates")
}

// ----------------------------------------------------------------------------
// LIVRAISON
// ----------------------------------------------------------------------------

model DeliveryAgent {
  id            String              @id @default(uuid())
  userId        String              @unique
  affiliation   DeliveryAffiliation
  vendorStoreId String?
  vehicleType   String?
  status        DeliveryAgentStatus @default(OFFLINE)
  currentLat    Float?
  currentLng    Float?
  lastPingAt    DateTime?

  user       User         @relation(fields: [userId], references: [id])
  vendorStore VendorStore? @relation(fields: [vendorStoreId], references: [id])
  deliveries Delivery[]
  trackingPings DeliveryTrackingPing[]

  @@map("delivery_agents")
}

model Delivery {
  id            String         @id @default(uuid())
  subOrderId    String         @unique
  agentId       String?
  pickupLat     Float
  pickupLng     Float
  dropoffLat    Float
  dropoffLng    Float
  status        DeliveryStatus @default(AWAITING_ASSIGNMENT)
  estimatedFee  Decimal        @db.Decimal(10, 2)
  finalFee      Decimal?       @db.Decimal(10, 2)
  distanceKm    Float?
  createdAt     DateTime       @default(now())
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?

  subOrder      OrderSubOrder           @relation(fields: [subOrderId], references: [id])
  agent         DeliveryAgent?          @relation(fields: [agentId], references: [id])
  trackingPings DeliveryTrackingPing[]
  proof         DeliveryProof?

  @@map("deliveries")
}

// Historique complet du trajet — traçabilité GPS totale
model DeliveryTrackingPing {
  id         String   @id @default(uuid())
  deliveryId String
  agentId    String
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  delivery Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  agent    DeliveryAgent @relation(fields: [agentId], references: [id])

  @@index([deliveryId])
  @@map("delivery_tracking_pings")
}

model DeliveryProof {
  id         String            @id @default(uuid())
  deliveryId String            @unique
  type       DeliveryProofType
  fileUrl    String?
  otpValue   String?
  verifiedAt DateTime?

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@map("delivery_proof")
}

// ----------------------------------------------------------------------------
// LITIGES
// ----------------------------------------------------------------------------

model Dispute {
  id               String        @id @default(uuid())
  orderId          String
  orderItemId      String?
  raisedByUserId   String
  reasonCategory   DisputeReason
  severity         String        @default("MEDIUM")
  payoutFrozen     Boolean       @default(false)
  description      String
  evidenceUrls     Json?
  status           DisputeStatus @default(OPEN)
  resolutionNote   String?
  resolvedByAdminId String?
  openedAt         DateTime      @default(now())
  slaDeadline      DateTime // openedAt + 48h
  resolvedAt       DateTime?

  order       Order      @relation(fields: [orderId], references: [id])
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  raisedBy    User       @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  resolvedBy  User?      @relation("DisputeResolvedBy", fields: [resolvedByAdminId], references: [id])
  messages    DisputeMessage[]

  @@map("disputes")
}

model DisputeMessage {
  id             String   @id @default(uuid())
  disputeId      String
  senderId       String
  content        String
  attachmentUrl  String?
  sentAt         DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_messages")
}

// ----------------------------------------------------------------------------
// PUBLICITÉ (activable via feature flag)
// ----------------------------------------------------------------------------

model AdCampaign {
  id            String           @id @default(uuid())
  advertiserId  String
  productId     String?
  type          AdType
  budgetAmount  Decimal          @db.Decimal(12, 2)
  currency      Currency
  costModel     AdCostModel
  startAt       DateTime
  endAt         DateTime
  status        AdCampaignStatus @default(DRAFT)
  createdAt     DateTime         @default(now())

  advertiser  User          @relation(fields: [advertiserId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])
  impressions AdImpression[]
  clicks      AdClick[]
  invoices    AdInvoice[]

  @@map("ad_campaigns")
}

model AdImpression {
  id            String   @id @default(uuid())
  campaignId    String
  viewerUserId  String?
  viewedAt      DateTime @default(now())
  pageContext   String?

  campaign AdCampaign @relation(fields: [campaignId], references: [id])

  @@map("ad_impressions")
}

model AdClick {
  id            String   @id @default(uuid())
  campaignId    String
  viewerUserId  String?
  clickedAt     DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id])

  @@map("ad_clicks")
}

model AdInvoice {
  id                    String   @id @default(uuid())
  campaignId            String
  amount                Decimal  @db.Decimal(12, 2)
  currency              Currency
  paymentTransactionId  String?
  issuedAt              DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id])

  @@map("ad_invoices")
}

// ----------------------------------------------------------------------------
// MESSAGERIE & NOTIFICATIONS
// ----------------------------------------------------------------------------

model Conversation {
  id      String           @id @default(uuid())
  type    ConversationType
  orderId String?

  messages     Message[]
  participants ConversationParticipant[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  sentAt         DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// PARAMÈTRES PLATEFORME (feature flags)
// ----------------------------------------------------------------------------

// Ex: { key: "ads_enabled", value: false } — permet d'activer le module
// publicité plus tard sans déploiement de code ni migration.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("platform_settings")
}

// ----------------------------------------------------------------------------
// AUDIT (sécurité & conformité)
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  beforeState   Json?
  afterState    Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
